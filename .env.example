# ForexMind environment template.
# Copy to .env.local (git-ignored) and fill in real values.

# ---- Database (required) ----
# Neon Postgres connection string. Synced to prisma/schema.prisma via `bun run db:push`.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ---- Auth (required) ----
# Secret used to sign the HMAC session cookie (forexmind_session).
# Generate with:  openssl rand -base64 32   (must be >= 16 chars)
AUTH_SECRET=

# ---- Groq AI (required) ----
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ---- Market data (optional) ----
# Used by /api/news and /api/prices. Without keys the app falls back to
# deterministic sample data with an honest "Sample data" badge.
FINNHUB_API_KEY=         # https://finnhub.io
TWELVE_DATA_API_KEY=     # https://twelvedata.com

# ---- Scheduled tasks (optional) ----
# Shared secret for /api/cron/alerts (price-alert sweep). Set it and
# point any external scheduler at:
#   GET /api/cron/alerts?secret=<CRON_SECRET>
# Without it the sweep still runs lazily whenever /api/prices is hit.
CRON_SECRET=
